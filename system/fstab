# /etc/fstab — VM 100 (Ubuntu 24.04 Docker host)
# Last verified: 2026-04-12
#
# <file system>                                    <mount point>         <type>  <options>                                                                                                  <dump> <pass>

# Root — 270GB virtual disk on Proxmox nvme-data pool
/dev/disk/by-uuid/<VM100_ROOT_UUID>                /                     ext4    defaults                                                                                                   0      1

# Swap
/swapfile                                          none                  swap    sw                                                                                                         0      0

# NVMe data disk — 1TB virtual disk on Proxmox nvme-data pool (n8n data, content media)
# Replaces dead 3.6TB NVMe (UUID f92a1abd-…) lost in Jan 2026 power surge
UUID=<VM100_NVME_UUID>                             /mnt/nvme             ext4    defaults,nofail,noatime,x-systemd.device-timeout=30                                                       0      0

# QNAP NAS (NFS)
<NAS_IP>:/Jesse                                    /mnt/nas              nfs     defaults,rw,soft,timeo=30,retrans=3,nofail,_netdev,x-systemd.device-timeout=60,x-systemd.automount        0      0

# TrueNAS Scale (VM 110) — NFS exports
<TRUENAS_IP>:/mnt/tank                             /mnt/truenas          nfs     defaults,nofail,x-systemd.device-timeout=60,_netdev,x-systemd.automount                                  0      0
<TRUENAS_IP>:/mnt/storage/data                     /mnt/truenas_storage  nfs     defaults,nofail,x-systemd.device-timeout=60,_netdev,x-systemd.automount                                  0      0
