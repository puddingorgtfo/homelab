{
  "name": "Homelab - n8n Self-Watchdog",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "c-trigger",
      "name": "Schedule: Every 1 Min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        -112
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:5678/healthz",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 5000
        }
      },
      "id": "c-http-check",
      "name": "HTTP: Check n8n Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        -112
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ !$json.error && ($json.status === 'ok' || $json.statusCode === undefined || $json.statusCode < 400) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c-if-healthy",
      "name": "IF: n8n Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        -112
      ]
    },
    {
      "parameters": {
        "jsCode": "const state = $getWorkflowStaticData('global');\nif (!state.failCount) state.failCount = 0;\nif (!state.lastFailTime) state.lastFailTime = null;\n\nstate.failCount++;\nstate.lastFailTime = new Date().toISOString();\n\nconst shouldRestart = state.failCount <= 2;\nreturn [{ json: { failCount: state.failCount, shouldRestart, lastFailTime: state.lastFailTime } }];"
      },
      "id": "c-code-check-retries",
      "name": "Code: Check Retry Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -16
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.shouldRestart }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c-if-should-restart",
      "name": "IF: Should Restart",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        896,
        -16
      ]
    },
    {
      "parameters": {
        "command": "docker compose -f /home/beanz/homelab/docker/automation/n8n/compose.yml restart 2>&1 | tail -5"
      },
      "id": "c-ssh-restart",
      "name": "SSH: Restart n8n",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        1120,
        -112
      ],
      "credentials": {
        "sshPassword": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "SSH Password account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{YOUR_TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "YOUR_CHAT_ID"
            },
            {
              "name": "text",
              "value": "n8n DOWN \u2014 2 restart attempts failed. SSH to YOUR_SERVER_IP to investigate. docker logs n8n --tail 30"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "c-http-alert-max",
      "name": "HTTP: Alert Max Retries via Telegram API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1120,
        80
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{YOUR_TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "YOUR_CHAT_ID"
            },
            {
              "name": "text",
              "value": "={{ 'n8n was unresponsive \u2014 restart attempted (attempt ' + $('Code: Check Retry Count').item.json.failCount + '/2). Checking again in 1 min.' }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "c-http-alert-restart",
      "name": "HTTP: Alert Restart Attempted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1344,
        -112
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const state = $getWorkflowStaticData('global');\nif (state.failCount && state.failCount > 0) {\n  // n8n recovered \u2014 clear the counter\n  state.failCount = 0;\n  state.lastFailTime = null;\n}\nreturn [{ json: { status: 'healthy', cleared: true } }];"
      },
      "id": "c-code-clear-state",
      "name": "Code: Clear Fail Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -208
      ]
    }
  ],
  "connections": {
    "Schedule: Every 1 Min": {
      "main": [
        [
          {
            "node": "HTTP: Check n8n Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP: Check n8n Health": {
      "main": [
        [
          {
            "node": "IF: n8n Healthy",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: n8n Healthy": {
      "main": [
        [
          {
            "node": "Code: Clear Fail Count",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Code: Check Retry Count",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code: Check Retry Count": {
      "main": [
        [
          {
            "node": "IF: Should Restart",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: Should Restart": {
      "main": [
        [
          {
            "node": "SSH: Restart n8n",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "HTTP: Alert Max Retries via Telegram API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SSH: Restart n8n": {
      "main": [
        [
          {
            "node": "HTTP: Alert Restart Attempted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "_n8n_id": "dD4x4o9c7BKkA8p9"
}