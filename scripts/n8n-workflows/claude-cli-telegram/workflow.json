      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        304
      ],
      "webhookId": "b3ae0ffe-b695-4717-a652-4767e48db841",
      "credentials": {
        "telegramApi": {
          "id": "lHMPJpvPfxv2kDva",
          "name": "Claude Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const chatId = $input.first().json.message.chat.id;\nconst prompt = $input.first().json.message.text;\n\n// Fresh session ID\nconst hex = chatId.toString(16).padStart(12, '0');\nconst sessionId = `55555555-5555-4555-a555-${hex}`;\n\n// Shell-escape the prompt\nconst escaped = prompt.replace(/'/g, \"'\\\\''\");\n\n// Kill any existing Claude process for this session, wait, then start new one\n// This prevents 'session in use' by killing the old process\nconst command = `pkill -9 -f \"${sessionId}\" 2>/dev/null || true; sleep 2; claude --session-id ${sessionId} -p '${escaped}'`;\n\nreturn [{\n  json: {\n    chatId,\n    prompt,\n    sessionId,\n    command\n  }\n}];"
      },
      "id": "build-command",
      "name": "Build Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "command": "={{ $json.command }}"
      },
      "id": "ssh-execute",
      "name": "SSH Execute",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        688,
        304
      ],
      "credentials": {
        "sshPassword": {
          "id": "ChMyMAazPGCOWob9",
          "name": "SSH Password account"
        }
      }
    },
