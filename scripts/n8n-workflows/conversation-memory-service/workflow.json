    {
      "parameters": {
        "jsCode": "// Get conversation history for user\nconst userId = $input.first().json.user_id;\nconst maxMessages = $input.first().json.max_messages || 5;\nconst staticData = getWorkflowStaticData('node');\n\n// Get conversation history\nconst conversation = staticData[userId] || [];\n\n// Return last N messages\nconst messages = conversation.slice(-maxMessages);\n\nreturn [{\n  json: {\n    user_id: userId,\n    messages: messages,\n    message_count: messages.length\n  }\n}];"
      },
      "id": "code-get-1",
      "name": "Get Conversation History",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "// Update conversation history for user\nconst userId = $input.first().json.user_id;\nconst message = $input.first().json.message;\nconst maxMessages = $input.first().json.max_messages || 5;\nconst staticData = getWorkflowStaticData('node');\n\n// Initialize or get conversation\nif (!staticData[userId]) {\n  staticData[userId] = [];\n}\n\n// Add new message with timestamp\nstaticData[userId].push({\n  ...message,\n  timestamp: new Date().toISOString()\n});\n\n// Keep only last N messages\nif (staticData[userId].length > maxMessages) {\n  staticData[userId] = staticData[userId].slice(-maxMessages);\n}\n\nreturn [{\n  json: {\n    user_id: userId,\n    messages: staticData[userId],\n    message_count: staticData[userId].length\n  }\n}];"
      },
      "id": "code-update-1",
      "name": "Update Conversation History",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
