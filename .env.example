# ===========================================
# Homelab Environment Variables
# Copy to .env and fill in actual values
# ===========================================

# --- General ---
TZ=America/New_York
PUID=1000
PGID=1000

# --- Nginx Proxy Manager ---
NPM_DB_PASSWORD=CHANGE_ME_PASSWORD

# --- Pi-hole ---
PIHOLE_WEBPASSWORD=CHANGE_ME_PASSWORD

# --- Immich (Photos) ---
IMMICH_DB_PASSWORD=CHANGE_ME_IMMICH_DB
IMMICH_PUBLIC_URL=https://photos.example.com

# --- Nextcloud ---
NEXTCLOUD_DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Paperless-NGX ---
PAPERLESS_DB_PASSWORD=CHANGE_ME_PASSWORD
PAPERLESS_SECRET_KEY=YOUR_SECRET_KEY_AT_LEAST_50_CHARS
PAPERLESS_URL=https://paperless.example.com

# --- WordPress ---
WP_DB_PASSWORD=CHANGE_ME_WP_PASSWORD

# --- Vaultwarden ---
VAULTWARDEN_ADMIN_TOKEN=YOUR_ARGON2_ADMIN_TOKEN
VAULTWARDEN_DOMAIN=http://192.168.1.100:8080

# --- Linkwarden ---
LINKWARDEN_DB_PASSWORD=CHANGE_ME_LINKWARDEN_DB
LINKWARDEN_SECRET=CHANGE_ME_LINKWARDEN_SECRET
LINKWARDEN_URL=https://links.burnhamandsons.com



# --- qBittorrent + VPN (Gluetun) ---
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=openvpn
OPENVPN_USER=YOUR_VPN_USERNAME
OPENVPN_PASSWORD=YOUR_VPN_PASSWORD

# --- n8n ---
N8N_API_KEY=YOUR_N8N_API_KEY

# --- Cloudflare Tunnel ---
# Configure in cloudflared/config.yml

# --- Homepage Dashboard ---
HOMEPAGE_ALLOWED_HOSTS=home.example.com

# --- Plex ---
PLEX_CLAIM=YOUR_PLEX_CLAIM_TOKEN

# --- Media paths ---
MEDIA_PATH=/mnt/nas
DOWNLOADS_PATH=/mnt/nvme/downloads
