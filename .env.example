# Environment Variables

# Paths
DOWNLOADS_PATH=/mnt/nas/downloads
MOVIES_PATH=/mnt/nas/media/movies
TV_PATH=/mnt/nas/media/tv

# API Keys
PLEX_CLAIM=claim-xxxx

# Database Passwords (examples - use strong passwords)
PAPERLESS_DB_PASSWORD=your-secure-password-here
IMMICH_DB_PASSWORD=your-secure-password-here
NEXTCLOUD_DB_PASSWORD=your-secure-password-here
NPM_DB_PASSWORD=your-secure-password-here
WORDPRESS_DB_PASSWORD=your-secure-password-here
LINKWARDEN_DB_PASSWORD=your-secure-password-here

# Service Configuration
VAULTWARDEN_ADMIN_TOKEN=your-argon2-hashed-token-here
VAULTWARDEN_DOMAIN=http://localhost:8080
CLOUDFLARED_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
PAPERLESS_SECRET_KEY=your-secret-key-at-least-50-chars-long-for-security
PAPERLESS_URL=https://paperless.example.com
IMMICH_PUBLIC_URL=https://photos.example.com
PIHOLE_WEBPASSWORD=your-secure-password-here
SEARXNG_BASE_URL=http://localhost:8082

# VPN Configuration
VPN_SERVICE_PROVIDER=mullvad
OPENVPN_USER=your-vpn-username
OPENVPN_PASSWORD=your-vpn-password